# /etc/systemd/system/boh.service（部署步骤见 deploy/README.md）
# 同时将 deploy/60-boh-timesyncd.conf 安装到 /etc/systemd/timesyncd.conf.d/60-boh-timesyncd.conf。
# 将 deploy/60-boh-resolved.conf 安装到 /etc/systemd/resolved.conf.d/60-boh-resolved.conf。
# 按这两个片段中的注释关闭网口 NTP 下发并设置 /etc/resolv.conf 的 stub 链接。
[Unit]
Description=Fengyan BOH store edge node
# 只依赖 network.target，不依赖 network-online：断网时节点照常工作
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/boh-server /etc/boh/config.toml
Environment=RUST_LOG=info

# panic = "abort" 后由 systemd 立即拉起
Restart=always
RestartSec=2

# 优雅关闭：SIGTERM → 停 HTTP 和新触发、取消 NTP 等待 → 执行完备份、闭店流程、自检与校时状态持久化 → 排空写队列 → WAL checkpoint（见 AGENTS.md「Rust」）
KillSignal=SIGTERM
TimeoutStopSec=120

# 门店签发 CA 的证书与私钥（/etc/boh/tls/，root 0600）以只读凭据交给服务，见 deploy/README.md、docs/tls.md。
# 随局域网 HTTPS 切片生效：文件不存在时服务无法启动，部署门店签发 CA 之后再取消注释。
# LoadCredential=store-ca.crt:/etc/boh/tls/store-ca.crt
# LoadCredential=store-ca.key:/etc/boh/tls/store-ca.key

# 数据目录 /var/lib/boh，无需手动创建用户
DynamicUser=yes
StateDirectory=boh
StateDirectoryMode=0750

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
